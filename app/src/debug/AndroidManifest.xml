<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
            Exported so `adb shell am broadcast` can reach it: the shell runs as a different
            uid and cannot deliver to a private receiver. This manifest is merged into debug
            builds only, so the receiver never ships.
        -->
        <receiver
            android:name=".debug.DebugAlertReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.migrainetracker.DEBUG_CHECK_ALERTS" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
