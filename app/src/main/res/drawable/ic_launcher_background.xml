<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon's background: one flat colour, which is all the artwork ever had. It was a
  432px PNG of a single repeated pixel value; as a vector it is exact at every density and the
  store icon can read the colour from here rather than sampling a bitmap for it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:name="ground"
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#2C2521" />
</vector>
